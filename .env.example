# Copy to .env and change the values locally. Never commit .env.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=eventsdb
POSTGRES_USER=events
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# Backend: the Spring Boot app reads this root .env automatically
# (spring.config.import in backend/src/main/resources/application.yml).
# Backend (future use)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/eventsdb
# JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# JWT_EXPIRATION_MINUTES=60

# Frontend (future use)
# VITE_API_BASE_URL=http://localhost:8080/api/v1
