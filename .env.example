# Copy to .env and change the values locally. Never commit .env.
# Used by docker-compose.yml (all services) and by the backend when you run it on your machine.

# ---- PostgreSQL ----
POSTGRES_DB=eventsdb
POSTGRES_USER=events
POSTGRES_PASSWORD=change-me
# Host port of the database. Containers always reach it internally as postgres:5432.
POSTGRES_PORT=5432

# ---- Backend ----
# When you run the backend on your machine it reads this root .env automatically
# (spring.config.import in backend/src/main/resources/application.yml).
# JWT signing secret (HS256). REQUIRED, at least 32 bytes; the app refuses to start otherwise.
# Generate one with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
# Access token lifetime in minutes (default 120 = 2 hours). No refresh tokens.
JWT_EXPIRATION_MINUTES=120

# ---- Host ports for `docker compose up --build` ----
# Backend API + Swagger UI: http://localhost:8080/swagger-ui.html
BACKEND_PORT=8080
# Frontend (nginx; proxies /api to the backend): http://localhost:3000
FRONTEND_PORT=3000

# The frontend API base URL is set in frontend/.env.example (default /api/v1, a relative URL
# that works both with the Vite dev proxy and behind nginx). No root setting is needed.
